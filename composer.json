{
    "name": "xman12/psysh-bundle",
    "type": "symfony-bundle",
    "description": "A port of the PHP REPL PsySH for Symfony.",
    "keywords": ["console", "psysh", "shell", "REPL", "symfony", "interactive"],
    "license": "MIT",
    "authors": [
        {
            "name": "Adrian Palmer",
            "email": "navitronic@gmail.com"
        },
        {
            "name": "Théo FIDRY",
            "email": "theo.fidry@gmail.com",
            "homepage": "https://github.com/theofidry"
        },
        {
            "name": "Belyshev Aleksandr",
            "email": "xman12@mail.ru",
            "homepage": "https://github.com/xman12"
        }
    ],

    "require": {
        "php": ">=8.1",
        "psy/psysh": "^0.11|^0.12",
        "symfony/error-handler": "^6.4",
        "symfony/expression-language": "^6.4",
        "symfony/framework-bundle": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "symfony/symfony": "^6.4"
    },

    "autoload": {
        "psr-4": {
            "xman12\\PsyshBundle\\": "src"
        },
        "files": [
            "src/psysh.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "xman12\\PsyshBundle\\": "tests"
        }
    },

    "config": {
        "bin-dir": "bin",
        "sort-packages": true
    }
}
